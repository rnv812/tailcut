{
  "manifest_version": 3,
  "name": "tailcut",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Clip already-buffered video from any site and save it as MP4",
  "permissions": ["storage", "downloads", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw/service-worker.js", "type": "module" },
  "action": { "default_popup": "popup/popup.html", "default_title": "tailcut" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page/main-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page/content.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["bridge/bridge.html", "bridge/bridge.js"], "matches": ["<all_urls>"] }
  ]
}
