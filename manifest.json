{
  "manifest_version": 3,
  "name": "tailcut",
  "version": "0.1.1",
  "minimum_chrome_version": "120",
  "description": "Turn already-buffered web video into precise MP4 clips or animated WebP",
  "incognito": "split",
  "icons": {
    "16": "assets/tailcut/icon/icon-16.png",
    "32": "assets/tailcut/icon/icon-32.png",
    "48": "assets/tailcut/icon/icon-48.png",
    "128": "assets/tailcut/icon/icon-128.png"
  },
  "permissions": ["storage", "downloads", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw/service-worker.js", "type": "module" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "tailcut",
    "default_icon": {
      "16": "assets/tailcut/icon/icon-16.png",
      "32": "assets/tailcut/icon/icon-32.png",
      "48": "assets/tailcut/icon/icon-48.png",
      "128": "assets/tailcut/icon/icon-128.png"
    }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page/main-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page/content.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["bridge/bridge.html", "bridge/bridge.js"], "matches": ["<all_urls>"] }
  ]
}
